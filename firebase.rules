rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Profiles: Anyone authenticated can read, but only owner can write
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Community Reports: Anyone authenticated can read and create, only owner can delete/update
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Scans: Private to the user
    match /scans/{scanId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Global Stats: Read-only for everyone
    match /stats/{statId} {
      allow read: if true;
      allow write: if false; // Only via Cloud Functions or Admin SDK
    }
  }
}
